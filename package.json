{
  "name": "dsh-agnes-image-video",
  "version": "1.0.0",
  "type": "module",
  "description": "Agnes Image 2.5 Flash 与 Agnes Video 2.5 Flash：两个工具 + 图形设置页，共用同一个 API Key。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "agnes",
    "agnes-ai",
    "image-generation",
    "video-generation",
    "text-to-image",
    "text-to-video",
    "settings-ui"
  ],
  "license": "MIT",
  "author": "dsh-agnes-image-video contributors",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/ui.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
